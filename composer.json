{
    "name": "salvatorecervone/laravel-firewall-gui",
    "description": "A Laravel firewall package with a built-in Blade GUI to manage IP, CIDR, range, and group-based whitelists and blacklists.",
    "keywords": [
        "laravel",
        "firewall",
        "ip",
        "cidr",
        "whitelist",
        "blacklist",
        "gui",
        "blade",
        "security"
    ],
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Salvatore"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/cache": "^11.0|^12.0",
        "illuminate/console": "^11.0|^12.0",
        "illuminate/database": "^11.0|^12.0",
        "illuminate/http": "^11.0|^12.0",
        "illuminate/routing": "^11.0|^12.0",
        "illuminate/support": "^11.0|^12.0",
        "illuminate/view": "^11.0|^12.0",
        "symfony/http-foundation": "^7.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "FirewallGui\\LaravelFirewallGui\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "FirewallGui\\LaravelFirewallGui\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "FirewallGui\\LaravelFirewallGui\\FirewallGuiServiceProvider"
            ],
            "aliases": {
                "Firewall": "FirewallGui\\LaravelFirewallGui\\Facades\\Firewall"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
